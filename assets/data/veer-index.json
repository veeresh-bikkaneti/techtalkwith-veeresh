---
---
[
{% for post in site.posts %}
{
  "type": "post",
  "title": {{ post.title | remove: "**" | jsonify }},
  "url": {{ post.url | relative_url | jsonify }},
  "date": {{ post.date | date: "%b %d, %Y" | jsonify }},
  "excerpt": {{ post.excerpt | strip_html | normalize_whitespace | jsonify }},
  "tags": {{ post.tags | jsonify }},
  "categories": {{ post.categories | jsonify }},
  "content": {{ post.content | strip_html | normalize_whitespace | truncate: 4000 | jsonify }}
}{% unless forloop.last %},{% endunless %}
{% endfor %}
{% assign about_page = site.pages | where: "title", "About" | first %}
{% if about_page %},
{
  "type": "about",
  "title": "About Veeresh Bikkaneti",
  "url": {{ about_page.url | relative_url | jsonify }},
  "date": "",
  "excerpt": "Principal QA Architect, AI Test Architect, Product Owner, and Scrum Master with 20+ years in enterprise quality engineering.",
  "tags": ["about", "resume", "veeresh", "background", "experience", "career", "contact"],
  "categories": ["about"],
  "content": {{ about_page.content | strip_html | normalize_whitespace | truncate: 6000 | jsonify }}
}
{% endif %}
]
